# Copie para .env e ajuste. NUNCA commite o .env.
# Toda variável nova deve ser documentada aqui (sem valores reais).
# Comentários sempre em linha própria (nem todo parser aceita comentário inline).

# development | staging | production
APP_ENV=development
# Interface e porta da API (make run)
APP_HOST=127.0.0.1
APP_PORT=8000
# debug | info | warning | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

# Portal de resultados e Portal de Dados Abertos do TSE
TSE_RESULTADOS_BASE=https://resultados.tse.jus.br/oficial
TSE_DADOS_ABERTOS_BASE=https://dadosabertos.tse.jus.br
# API de malhas do IBGE (mapas)
IBGE_MALHAS_BASE=https://servicodados.ibge.gov.br/api/v3/malhas
# Segundos de cache em memória dos JSONs do portal
TSE_JSON_TTL=900
# Requisições simultâneas ao portal do TSE
TSE_MAX_CONCURRENCY=16
TSE_USER_AGENT=tse-api/0.1 (consulta de dados publicos)

# Cache de arquivos de urna, downloads e base DuckDB
TSE_DATA_DIR=data
# Opcional: caminho da base DuckDB (padrão: $TSE_DATA_DIR/bweb.duckdb)
TSE_DB_PATH=

# Build do frontend servido pela API (inexistente = só a API)
FRONTEND_DIST=frontend/dist
# Origens liberadas no CORS, separadas por vírgula (desnecessário com o proxy do Vite)
CORS_ORIGINS=
